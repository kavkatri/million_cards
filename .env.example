# Copy to .env and fill in. docker-compose refuses to start without the three
# required values, rather than silently booting with dev defaults.

POSTGRES_USER=million
POSTGRES_PASSWORD=change-me
POSTGRES_DB=million_cards

# Signs session cookies.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts stored marketplace API tokens. Changing this makes existing stored
# tokens unreadable, so keep it backed up alongside the database.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Port on the host. Bound to 127.0.0.1 by compose; put a TLS proxy in front
# before exposing it.
WEB_PORT=8080
# Host interface for the published port. Leave as-is for a local run. On a
# managed platform the proxy reaches the service over the compose network as
# web:8000, so you usually do not need this at all.
WEB_BIND=127.0.0.1


# Coroutines per worker container. Raising this is safe: the per-account token
# buckets, not this number, bound the marketplace request rate.
WORKER_CONCURRENCY=8

LOG_LEVEL=INFO
